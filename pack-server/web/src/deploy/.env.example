# ============================================================
#  uni-app 安卓离线打包 · 打包参数
#  用法：复制成 .env 再改（cp .env.example .env）
#  留空的项会走镜像默认值，不影响启动
# ============================================================

# ---- 必填 ----
# uni-app appid，如 __UNI__6744715
APP_ID=__UNI__XXXXXXX
# 应用名（显示在手机桌面）
APP_NAME=我的应用
# 包名 applicationId
APP_PACKAGE=com.company.app
# 版本名，如 2.3.7
APP_VERSION_NAME=1.0.0
# 版本号（整数，每次上架必须递增）
APP_VERSION_CODE=1

# ---- DCloud 离线打包 key ----
# 不填真机会提示「appkey未配置或配置错误」
# 获取：dev.dcloud.net.cn → 应用 → 各平台信息 → Android → 离线打包 key
APP_KEY=

# ---- 原生配置（留空用 SDK 模板默认：minSdk 21 / targetSdk 33）----
# 商店上架通常要求 targetSdk ≥ 30
MIN_SDK=28
TARGET_SDK=30

# ---- 权限增删，逗号分隔，只写权限名（不用 android.permission. 前缀）----
# ADD_PERMISSIONS=CAMERA,POST_NOTIFICATIONS
# DEL_PERMISSIONS=READ_MEDIA_VIDEO,READ_EXTERNAL_STORAGE

# ---- 渠道包，逗号分隔；留空只打通用包 ----
# CHANNELS=huawei,xiaomi,oppo

# ---- 签名（留空用镜像内置 auto.jks，仅供测试）----
# KEYSTORE_FILE=/workspace/config/release.jks
# STORE_PASSWORD=
# KEY_ALIAS=
# KEY_PASSWORD=

# ---- 启动图：底色 auto=取图标四角颜色，也可写 #FFFFFF ----
# SPLASH_BG=auto
# SPLASH_HEIGHT=2400

# ---- 构建 ----
# 1=走国内镜像加速（默认），0=直连
USE_CN_MIRROR=1
